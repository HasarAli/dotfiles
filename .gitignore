.claude/
dot-pi/agent/sessions/

# Claude Code's runtime state (credentials, history, projects), for a machine
# whose ~/.claude is a stow link to dot-claude; only the config is tracked.
dot-claude/*
!dot-claude/output-styles/
!dot-claude/settings.json
!dot-claude/skills
!dot-claude/statusline.sh

# herdr runtime. plugins.list is the tracked source; plugins.json is herdr's own
# registry, written at install time with machine-absolute paths.
dot-config/herdr/plugins.json
dot-config/herdr/*.log
dot-config/herdr/*.sock
dot-config/herdr/session.json
dot-config/herdr/session-snapshots/
dot-config/herdr/.plugins.lock
dot-config/herdr/plugins/

# decrypted secrets never enter the repo
secrets/*.dec*
secrets/*.env
secrets/*.dotenv
dot-pi/agent/auth.json
dot-config/age/

# worktrunk's per-machine command approvals
dot-config/worktrunk/approvals.toml*

# pi runtime state: trusted projects and local model stores
# (models-store.json is already ignored above)
dot-pi/agent/trust.json

# regenerated by their tools, not worth tracking
.DS_Store
dot-pi/agent/models-store.json
dot-pi/agent/extensions/herdr-agent-state.ts
macos/
dot-config/herdr/release-notes.json
dot-config/configstore/

# skill-installer lock, written to ~/.agents by a tool outside this repo
dot-agents/.skill-lock.json

# skills Claude Code downloads from the claude.ai account into ~/.claude/skills
dot-agents/skills/synced/
