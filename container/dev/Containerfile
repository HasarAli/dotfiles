FROM debian:trixie-slim

ARG DEV_UID=1000
ARG DEV_GID=1000
ARG DOTFILES_REPO=https://github.com/HasarAli/dotfiles.git

ENV HOME=/home/dev \
    TERM=xterm-256color \
    COLORTERM=truecolor \
    LANG=C.UTF-8 \
    PNPM_HOME=/home/dev/.local/share/pnpm \
    PATH=/home/dev/.local/share/pnpm:/home/dev/.local/bin:/home/dev/.local/share/mise/shims:${PATH} \
    PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

RUN set -eux; \
    apt-get update -qq; \
    DEBIAN_FRONTEND=noninteractive apt-get install -qq -y --no-install-recommends \
        ca-certificates curl git gosu sudo openssh-client \
        build-essential unzip xz-utils less procps poppler-utils chromium; \
    groupadd --gid "${DEV_GID}" dev; \
    useradd --uid "${DEV_UID}" --gid dev --create-home --shell /bin/bash dev; \
    rm -f /home/dev/.bashrc /home/dev/.profile /home/dev/.bash_logout; \
    git clone --depth 1 "${DOTFILES_REPO}" /home/dev/dotfiles; \
    chown -R dev:dev /home/dev; \
    printf 'dev ALL=(root) NOPASSWD: /usr/bin/apt-get\n' > /etc/sudoers.d/dev-bootstrap; \
    chmod 440 /etc/sudoers.d/dev-bootstrap; \
    gosu dev env MISE_TRUSTED_CONFIG_PATHS=/home/dev/dotfiles \
        bash /home/dev/dotfiles/install_deps.sh; \
    gosu dev mise exec -- npm install -g pnpm; \
    gosu dev mise exec -- pnpm config set global-bin-dir "${PNPM_HOME}"; \
    gosu dev mise exec -- pnpm config set store-dir "${PNPM_HOME}/store"; \
    mkdir -p /home/dev/app/node_modules "${PNPM_HOME}/store"; \
    chown -R dev:dev /home/dev; \
    rm /etc/sudoers.d/dev-bootstrap; \
    SUDO_FORCE_REMOVE=yes apt-get purge -y sudo; \
    rm -rf /var/lib/apt/lists/*

COPY --chmod=755 entrypoint.sh /usr/local/bin/devcontainer-entrypoint

WORKDIR /home/dev/app
EXPOSE 3000

# Only mounted data is repaired as root; the entrypoint immediately drops to dev.
USER root
ENTRYPOINT ["devcontainer-entrypoint"]
CMD ["bash"]
