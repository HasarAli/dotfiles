# Optional: copy to .env beside compose.yaml. Never commit the resulting .env.
# Relative PROJECT_DIR paths are resolved from container/dev.
PROJECT_DIR=../..
COMPOSE_PROJECT_NAME=myproject
DEV_IMAGE=myproject-dev:latest
DEV_PORT=3000
DEV_UID=1000
DEV_GID=1000

# Build-time repository: changing this requires rebuilding and fresh volumes.
DOTFILES_REPO=https://github.com/HasarAli/dotfiles.git

# Defaults to $HOME/.ssh. The directory must exist; the mount is read-only.
# SSH_DIR=/home/you/.ssh
# macOS SSH config needs IgnoreUnknown UseKeychain for Linux clients.

# Optional API keys belong only in your local .env, never in the image.
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
