{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--auto-connect",
        "--no-headless",
        "--no-isolated",
        "--viewport=1280x720",
        "--screenshot-format=webp",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--no-category-performance",
        "--no-category-emulation",
        "--no-category-network",
        "--no-memory-debugging",
        "--experimental-page-id-routing",
        "--experimental-vision",
        "--experimental-screencast",
        "--experimental-ffmpeg-path=/usr/bin/ffmpeg"
      ]
    }
  }
}
