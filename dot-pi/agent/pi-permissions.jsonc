{
  "$schema": "./pi-permissions.schema.json",
  // Default: allow everything silently, ask for MCP
  "defaultPolicy": {
    "tools": "allow",
    "bash": "allow",
    "mcp": "ask",
    "skills": "allow",
    "special": "ask"
  },
  // ── Blacklist: never touch these paths ──
  // Last-declared-match wins; deny rules override the allow-all default.
  "tools": {
    // SSH / GPG / age keys
    "read:~/.ssh/*": "deny",
    "write:~/.ssh/*": "deny",
    "edit:~/.ssh/*": "deny",
    "read:~/.gnupg/*": "deny",
    "write:~/.gnupg/*": "deny",
    "edit:~/.gnupg/*": "deny",
    "read:~/.config/age/*": "deny",
    "write:~/.config/age/*": "deny",
    "edit:~/.config/age/*": "deny",
    // Cloud credentials
    "read:~/.aws/*": "deny",
    "write:~/.aws/*": "deny",
    "edit:~/.aws/*": "deny",
    "read:~/.config/gcloud/*": "deny",
    "write:~/.config/gcloud/*": "deny",
    "edit:~/.config/gcloud/*": "deny",
    // Network / registry credentials
    "read:~/.netrc": "deny",
    "write:~/.netrc": "deny",
    "edit:~/.netrc": "deny",
    "read:~/.docker/config.json": "deny",
    "write:~/.docker/config.json": "deny",
    "edit:~/.docker/config.json": "deny",
    "read:~/.npmrc": "deny",
    "write:~/.npmrc": "deny",
    "edit:~/.npmrc": "deny",
    // CLI tokens
    "read:~/.config/gh/*": "deny",
    "write:~/.config/gh/*": "deny",
    "edit:~/.config/gh/*": "deny",
    // Kubernetes
    "read:~/.kube/*": "deny",
    "write:~/.kube/*": "deny",
    "edit:~/.kube/*": "deny",
    // Secrets directories (any project)
    "read:**/secrets/*": "deny",
    "write:**/secrets/*": "deny",
    "edit:**/secrets/*": "deny",
    // .env files (any project)
    "read:**/.env": "deny",
    "read:**/.env.*": "deny",
    "write:**/.env*": "deny",
    "edit:**/.env*": "deny"
  },
  // Bash: block env var dumps and any command referencing secret-like strings.
  // Broad patterns — any command containing these substrings is denied.
  "bash": {
    "env": "deny",
    "printenv": "deny",
    "env *": "deny",
    "printenv *": "deny",
    "*API_KEY*": "deny",
    "*_SECRET*": "deny",
    "*_TOKEN*": "deny",
    "*_PASSWORD*": "deny"
  },
  "special": {
    "doom_loop": "ask",
    "external_directory": "ask"
  }
}
