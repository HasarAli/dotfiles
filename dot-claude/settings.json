{
  "respectGitignore": false,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "permissions": {
    "deny": [
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "EnterPlanMode",
      "ExitPlanMode",
      "AskUserQuestion",
      "PushNotification",
      "RemoteTrigger",
      "EnterWorktree",
      "ExitWorktree",
      "DesignSync",
      "NotebookEdit",
      "ReportFindings",
      "ScheduleWakeup",
      "TaskOutput",
      "CronCreate",
      "CronDelete",
      "CronList"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.claude/hooks/herdr-agent-state.sh\" ] && \"$HOME/.claude/hooks/herdr-agent-state.sh\" session; true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "disableWorkflows": true,
  "enableArtifact": false,
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "cowork-plugin-management@synced": false,
    "cc-plugin-telemetry@builtin": false,
    "cc-plugin-plugin-authoring@builtin": false,
    "skill-creator@claude-plugins-official": true
  },
  "outputStyle": "Concise",
  "feedbackDrafts": "notify",
  "spinnerTipsEnabled": false,
  "effortLevel": "medium",
  "autoCompactWindow": 200000,
  "promptSuggestionEnabled": false,
  "emojiCompletionEnabled": false,
  "awaySummaryEnabled": false,
  "responseComparisonEnabled": false,
  "askUserQuestionTimeout": "60s",
  "dialogExpiry": "60s",
  "autoUpdatesChannel": "stable",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "showThinkingSummaries": false,
  "theme": "dark",
  "editorMode": "vim",
  "verbose": false,
  "precomputeCompactionEnabled": true,
  "idleCompaction": true,
  "switchModelsOnFlag": false,
  "autoContinueAtUsageLimit": false,
  "terminalProgressBarEnabled": false,
  "todoFeatureEnabled": false,
  "remoteControlAtStartup": false,
  "crossSessionInbound": "accept",
  "autoUploadSessions": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "defaultToAgentsView": true,
  "leftArrowOpensAgents": true,
  "prStatusFooterEnabled": false,
  "claudeInChromeDefaultEnabled": false,
  "autoConnectIde": false,
  "autoInstallIdeExtension": false,
  "autoAddRemoteControlDaemonWorker": false
}
