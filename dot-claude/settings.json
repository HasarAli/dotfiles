{
  "permissions": {
    "deny": [
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "EnterPlanMode",
      "ExitPlanMode",
      "AskUserQuestion",
      "PushNotification",
      "RemoteTrigger",
      "EnterWorktree",
      "ExitWorktree",
      "DesignSync",
      "NotebookEdit",
      "ReportFindings",
      "ScheduleWakeup",
      "TaskOutput",
      "CronCreate",
      "CronDelete",
      "CronList"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "skillOverrides": {
    "artifact-design": "off",
    "keybindings-help": "off",
    "schedule": "off",
    "init": "off",
    "review": "off",
    "security-review": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:deep-research": "off",
    "cowork-plugin-management:cowork-plugin-customizer": "off",
    "cowork-plugin-management:create-cowork-plugin": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.claude/hooks/herdr-agent-state.sh\" ] && \"$HOME/.claude/hooks/herdr-agent-state.sh\" session; true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "disableWorkflows": true,
  "disableArtifact": true,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "cowork-plugin-management@synced": false,
    "cc-plugin-telemetry@builtin": false,
    "cc-plugin-plugin-authoring@builtin": false
  },
  "outputStyle": "bluf",
  "feedbackDrafts": "notify",
  "effortLevel": "medium",
  "autoCompactWindow": 200000,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "60s",
  "dialogExpiry": "60s",
  "autoUpdatesChannel": "stable",
  "autoMemoryEnabled": false,
  "theme": "dark",
  "editorMode": "vim",
  "verbose": false,
  "switchModelsOnFlag": false,
  "autoContinueAtUsageLimit": false,
  "terminalProgressBarEnabled": false,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "crossSessionInbound": "accept"
}
