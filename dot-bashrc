case $- in
    *i*) ;;
    *) return ;;
esac

# Claude Code: default to fullscreen rendering (= `tui: fullscreen`)
export CLAUDE_CODE_NO_FLICKER=1

# Pi: extend prompt cache TTL to 1h (default: 5m)
export PI_CACHE_RETENTION=long

# GNU Coreutils path alignment for color support
if command -v dircolors &>/dev/null; then
    eval "$(dircolors -b)"
    alias ls='ls --color=auto'
elif command -v gls &>/dev/null; then
    alias ls='gls --color=auto'
else
    alias ls='ls -G'
fi

# Shell options and history
set -o noclobber
shopt -s checkwinsize histappend cmdhist globstar autocd dirspell cdspell cdable_vars histverify 2>/dev/null

PROMPT_DIRTRIM=3
CDPATH="."
bind Space:magic-space

HISTSIZE=999999
HISTFILESIZE=999999
HISTCONTROL="erasedups:ignoreboth"
HISTTIMEFORMAT='%F %T '
export HISTIGNORE="&:[ ]*:exit:ls:bg:fg:history:clear"
PROMPT_COMMAND='history -a'

# Git prompt and completion
GIT_PROMPT_PATHS=(
    "/opt/homebrew/etc/bash_completion.d/git-prompt.sh"
    "/usr/lib/git-core/git-sh-prompt"
    "/usr/share/git-core/git-prompt.sh"
    "/Library/Developer/CommandLineTools/usr/share/git-core/git-prompt.sh"
)

for path in "${GIT_PROMPT_PATHS[@]}"; do
    if [ -f "$path" ]; then
        . "$path"
        break
    fi
done

GIT_PS1_SHOWDIRTYSTATE=1
GIT_PS1_SHOWUNTRACKEDFILES=1
GIT_PS1_SHOWUPSTREAM="git"
GIT_PS1_SHOWCONFLICTSTATE="yes"

if command -v __git_ps1 &>/dev/null; then
    PS1='\[\033[01;34m\]\w\[\033[33m\]$(__git_ps1 " (%s)")\[\033[00m\]\$ '
else
    PS1='\[\033[01;34m\]\w\[\033[00m\]\$ '
fi

# Load package manager completions (Homebrew / Debian APT)
if ! shopt -oq posix; then
    if [ -f "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh" ]; then
        . "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh"
    elif [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    fi
fi

# Aliases and tools
[ -f ~/.bash_aliases ] && . ~/.bash_aliases

# This file is stowed, so its own symlink chain locates the repo.
if [ -z "${DOTFILES:-}" ]; then
    _df_src=${BASH_SOURCE[0]}
    while [ -L "$_df_src" ]; do
        _df_target=$(readlink "$_df_src")
        case $_df_target in
            /*) _df_src=$_df_target ;;
            *)  _df_src=$(dirname "$_df_src")/$_df_target ;;
        esac
    done
    DOTFILES=$(cd -P "$(dirname "$_df_src")" && pwd)
    unset _df_src _df_target
fi
export DOTFILES

# API keys (sops+age encrypted; key at ~/.config/age/keys.txt)
export SOPS_AGE_KEY_FILE=~/.config/age/keys.txt
if command -v sops &>/dev/null && [ -f "$DOTFILES/secrets/env.yaml" ]; then
    eval "$(sops -d --output-type dotenv "$DOTFILES/secrets/env.yaml" 2>/dev/null | sed 's/^/export /')"
fi

# Hound BYOK — reuse existing keys to escalate past its keyless search when needed
[ -n "${SERPER_API_KEY:-}" ]    && export HOUND_SEARCH_SERPER_KEYS="$SERPER_API_KEY"
[ -n "${EXA_API_KEY:-}" ]       && export HOUND_SEARCH_EXA_KEYS="$EXA_API_KEY"
[ -n "${FIRECRAWL_API_KEY:-}" ] && export HOUND_SEARCH_FIRECRAWL_KEYS="$FIRECRAWL_API_KEY"

# Herdr multiplexer
if command -v herdr &>/dev/null &&
	[ -z "$HERDR_ENV" ] &&
	[ "$TERM_PROGRAM" != "vscode" ]; then
    herdr
fi
